# Firebase Configuration Template
# Copy this file to .env.local and fill in your actual values

# Firebase Project Configuration
NEXT_PUBLIC_FIREBASE_PROJECT_ID=merakierp
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=merakierp.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=merakierp.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_APP_ID

# Firebase Admin SDK Service Account (for server-side operations)
# This should be the entire JSON service account key as a string
# Get this from: Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"merakierp",...}

# INSTRUCTIONS FOR PRODUCTION DEPLOYMENT:
# 1. Copy this file: cp .env.template .env.local
# 2. Go to Firebase Console (https://console.firebase.google.com)
# 3. Select your project 'merakierp'
# 4. Go to Project Settings > General > Your apps
# 5. If no web app exists, click "Add app" and create a web app
# 6. Copy the Firebase config values to replace the placeholders above:
#    - API Key (starts with "AIza...")
#    - Messaging Sender ID (numeric)
#    - App ID (starts with "1:")
# 7. Go to Project Settings > Service Accounts
# 8. Generate a new private key and copy the entire JSON as a string for FIREBASE_SERVICE_ACCOUNT_KEY
# 9. Save the file
# 10. Deploy: npm run deploy

# For local development with emulators, you can use placeholder values
# The emulators will work with any valid format values
