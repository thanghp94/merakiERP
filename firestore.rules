rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // TEMPORARY: Allow public read/write for testing - REMOVE IN PRODUCTION
    match /{document=**} {
      allow read, write: if true;
    }
    
    // Specific rules for collections
    
    // Students collection
    match /students/{studentId} {
      // Students can only read/write their own data
      // Teachers and admins can read/write all students
      allow read, write: if request.auth != null && 
        (request.auth.token.role in ['teacher', 'admin'] || 
         request.auth.uid == studentId);
    }
    
    // Facilities collection
    match /facilities/{facilityId} {
      // All authenticated users can read facilities
      allow read: if request.auth != null;
      // Only teachers and admins can write facilities
      allow write: if request.auth != null && 
        request.auth.token.role in ['teacher', 'admin'];
    }
    
    // Classes collection
    match /classes/{classId} {
      // All authenticated users can read classes
      allow read: if request.auth != null;
      // Only teachers and admins can write classes
      allow write: if request.auth != null && 
        request.auth.token.role in ['teacher', 'admin'];
    }
    
    // Employees collection
    match /employees/{employeeId} {
      // Employees can read their own data
      // Teachers and admins can read all employees
      allow read: if request.auth != null && 
        (request.auth.token.role in ['teacher', 'admin'] || 
         request.auth.uid == employeeId);
      // Only admins can write employee data
      allow write: if request.auth != null && 
        request.auth.token.role == 'admin';
    }
    
    // Enrollments collection
    match /enrollments/{enrollmentId} {
      // Students can read their own enrollments
      // Teachers and admins can read all enrollments
      allow read: if request.auth != null;
      // Only teachers and admins can manage enrollments
      allow write: if request.auth != null && 
        request.auth.token.role in ['teacher', 'admin'];
    }
    
    // Attendance collection
    match /attendance/{attendanceId} {
      // Students can read their own attendance
      // Teachers and admins can read/write all attendance
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        request.auth.token.role in ['teacher', 'admin'];
    }
    
    // Finances collection
    match /finances/{financeId} {
      // Students can read their own financial records
      // Teachers and admins can read all financial records
      allow read: if request.auth != null;
      // Only admins can manage financial records
      allow write: if request.auth != null && 
        request.auth.token.role == 'admin';
    }
    
    // Tasks collection
    match /tasks/{taskId} {
      // Employees can read tasks assigned to them
      // Teachers and admins can read all tasks
      allow read: if request.auth != null;
      // Teachers and admins can manage tasks
      allow write: if request.auth != null && 
        request.auth.token.role in ['teacher', 'admin'];
    }
  }
}